generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL é resolvida pela variável de ambiente (DATABASE_URL), 
  // que deve conter o schema.
  url      = env("DATABASE_URL")
  
  // A propriedade 'schema' foi removida deste bloco.
}

model Pagamento {
  // id: ID próprio da classe (Int, autoincrementável)
  idPagamento      Int      @id @default(autoincrement()) 
  
  // idCliente: String
  idCliente        String   
  
  // descricao: Descrição do pagamento
  descricao        String
  
  // valor: double
  valor            Float
  
  // metodoPagamento: String
  metodoPagamento  String   
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("pagamentos") // Nome da tabela no banco
}